# Cloudflare Pages / Workers static-assets _headers
# Applied to every response served from this repo. Closes the security-header
# gaps from SPEC-AUDIT.md + sets sane caching and the .md content-type.

# HSTS is LIVE and matches the line below. Production serves
# `strict-transport-security: max-age=31536000; includeSubDomains` — verified
# 2026-07-29 with: curl -sI https://markdownwebclipper.com/
# Cloudflare's zone-level HSTS setting (SSL/TLS -> Edge Certificates -> HTTP Strict
# Transport Security) is enabled and agrees with this value. The zone setting takes
# precedence over this file, so re-run the curl above after any Cloudflare SSL/TLS
# change to confirm the two still agree.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Un-fingerprinted CSS/JS: revalidate so a deploy is picked up promptly.
# (restore.js is external so the strict global script-src 'self' above covers it
# — the magic-link bridge no longer needs an inline-script CSP exception.)
/style.css
  Cache-Control: public, max-age=3600, must-revalidate
/tokens.css
  Cache-Control: public, max-age=3600, must-revalidate
/landing.js
  Cache-Control: public, max-age=3600, must-revalidate

# Fonts never change between deploys — cache hard. (All fonts live under /fonts/,
# so one rule covers them; a second /*.woff2 rule would duplicate the header.)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static media — long but not immutable (may be re-exported).
/demo.mp4
  Cache-Control: public, max-age=604800
/demo.webm
  Cache-Control: public, max-age=604800
/demo-poster.png
  Cache-Control: public, max-age=604800
/demo.gif
  Cache-Control: public, max-age=604800
/og-hero.png
  Cache-Control: public, max-age=604800

# Raw Markdown twin endpoints (per-page .md source for agents).
/*.md
  Content-Type: text/markdown; charset=utf-8

# Link-header discovery for agents that never parse the HTML.
/
  Link: </llms.txt>; rel="llms-txt"
  Link: </sitemap.xml>; rel="sitemap"
  Link: </blog/feed.xml>; rel="alternate"; type="application/rss+xml"
